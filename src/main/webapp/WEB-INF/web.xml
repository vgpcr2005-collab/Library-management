<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <display-name>Alliance University Smart Library</display-name>
  <filter>
    <filter-name>secureCookieFilter</filter-name>
    <filter-class>edu.alliance.library.filter.SecureCookieFilter</filter-class>
  </filter>
  <filter>
    <filter-name>localOnlyFilter</filter-name>
    <filter-class>edu.alliance.library.filter.LocalOnlyFilter</filter-class>
  </filter>
  <filter>
    <filter-name>securityHeadersFilter</filter-name>
    <filter-class>edu.alliance.library.filter.SecurityHeadersFilter</filter-class>
  </filter>
  <filter>
    <filter-name>csrfFilter</filter-name>
    <filter-class>edu.alliance.library.filter.CsrfFilter</filter-class>
  </filter>
  <filter-mapping><filter-name>secureCookieFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>localOnlyFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>securityHeadersFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>csrfFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <session-config>
    <session-timeout>20</session-timeout>
    <cookie-config><http-only>true</http-only></cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>
  <welcome-file-list><welcome-file>app/dashboard</welcome-file></welcome-file-list>
</web-app>
